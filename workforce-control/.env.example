# Client-side (Vite, embedded in the browser bundle — never put secrets here)
VITE_AION_RUNTIME_URL=
VITE_AION_TENANT_ID=aion-systems

# Server-only (the BFF's — used by api/*.ts, never exposed to the browser).
# Needed only when running `npx vercel dev`; irrelevant to plain `vite dev`.
RUNTIME_URL=
AION_GATEWAY_TOKEN=
CONSOLE_LOGIN_SECRET=
SESSION_SIGNING_SECRET=
